## Mako Configuration - Tokyo Night Theme
max-history=100
sort=-time

# Appearance
font=JetBrains Mono 12
width=350
height=150
margin=20
padding=15
border-size=2
border-radius=10
icons=1
max-icon-size=64

# Colors (Tokyo Night)
background-color=#1a1b26
text-color=#c0caf5
border-color=#7aa2f7
progress-color=over #414868

# Default Timeout
default-timeout=5000

# --- Urgency Levels ---

[urgency=low]
border-color=#414868
default-timeout=2000

[urgency=normal]
border-color=#7aa2f7

[urgency=high]
border-color=#f7768e
text-color=#f7768e
default-timeout=0